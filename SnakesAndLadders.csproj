<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>images\snake.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Company>Radish</Company>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="images\blueToken.png" />
    <None Remove="images\blueToken2.png" />
    <None Remove="images\board.png" />
    <None Remove="images\dice.png" />
    <None Remove="images\grayToken.png" />
    <None Remove="images\grayToken2.png" />
    <None Remove="images\greenToken.png" />
    <None Remove="images\greenToken2.png" />
    <None Remove="images\purpleToken.png" />
    <None Remove="images\purpleToken2.png" />
    <None Remove="images\redToken.png" />
    <None Remove="images\redToken2.png" />
    <None Remove="images\soundOff.png" />
    <None Remove="images\soundOn.png" />
    <None Remove="sounds\applause.wav" />
    <None Remove="sounds\gameover.wav" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="images\snake.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="images\blueToken.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\blueToken2.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\board.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\dice.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\grayToken.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\grayToken2.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\greenToken.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\greenToken2.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\purpleToken.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="images\purpleToken2.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
