<Window x:Class="SnakesAndLadders.ChooseToken"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SnakesAndLadders"
        mc:Ignorable="d"
        Title="Choose:"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Height="150" Width="350">
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Background="White" Click="GreenButton_Click">
                <Image Source="/images/greenToken3.png" Width="80" Height="80"/>
            </Button>
            <Button Background="White" Click="BlueButton_Click">
                <Image Source="/images/blueToken3.png" Width="80" Height="80"/>
            </Button>
            <Button Background="White" Click="PurpleButton_Click">
                <Image Source="/images/purpleToken3.png" Width="80" Height="80"/>
            </Button>
            <Button Background="White" Click="GrayButton_Click">
                <Image Source="/images/grayToken3.png" Width="80" Height="80"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
